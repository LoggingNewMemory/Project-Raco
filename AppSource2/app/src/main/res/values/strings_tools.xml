    <!-- PixelSleep -->
    <string name="pixelsleep_title">PixelSleep</string>
    <string name="util_desc_pixelsleep">Turn off a few pixels to save battery on OLED screens</string>
    <string name="util_kw_pixelsleep">pixel sleep oled amoled battery power saving screen dots</string>
    <string name="pixelsleep_enable">Enable PixelSleep</string>
    <string name="pixelsleep_enable_desc">Keeps a small share of screen pixels black, everywhere including in games.</string>
    <string name="pixelsleep_amount">Pixels turned off</string>
    <string name="pixelsleep_amount_value">%1$d%% of pixels (about 1 of every %2$d)</string>
    <string name="pixelsleep_size">Pixel size</string>
    <string name="pixelsleep_size_value">%1$d px</string>
    <string name="pixelsleep_note">Only saves battery on OLED/AMOLED screens; LCD screens gain nothing. A higher amount saves more but makes the dots more visible. In the Game Assistant PixelSleep is just an on/off switch, the amount is set here.</string>
    <string name="pixelsleep_perm_title">Overlay permission needed</string>
    <string name="pixelsleep_perm_desc">PixelSleep draws over other apps. Allow it to continue.</string>
    <string name="pixelsleep_perm_btn">Grant permission</string>
